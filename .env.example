# ---------------------------------------------------------------------------
# Kirana — exemplo de configuração. Copie para ".env" e preencha.
# NUNCA versione o arquivo .env (ele está no .gitignore).
# ---------------------------------------------------------------------------

# --- Gateway ChatGPT já existente (não é reescrito por este projeto) -------
KIRANA_GATEWAY_URL=http://127.0.0.1:1455
# Cole aqui a GATEWAY_API_KEY do .env do gateway. Ela fica APENAS no backend.
KIRANA_GATEWAY_API_KEY=

# --- Orquestração -----------------------------------------------------------
# langgraph = grafo de estados (padrão) | legacy = loop da Fase 1 (rollback)
KIRANA_ORCHESTRATOR=langgraph

# --- Modelos ---------------------------------------------------------------
KIRANA_PRIMARY_MODEL=gpt-6-luna
KIRANA_FALLBACK_MODEL=gpt-6.1-sol
# Usa o fallback apenas se a chamada falhar antes de qualquer token/ferramenta.
KIRANA_ALLOW_FALLBACK=true
# Confere em GET /v1/models se o modelo primário existe antes de usar.
KIRANA_MODEL_PROBE=true

# --- Servidor local da Kirana ---------------------------------------------
KIRANA_HOST=127.0.0.1
KIRANA_PORT=3000

# Token opcional entre navegador e backend. Se vazio, o backend aceita apenas
# requisições da própria interface local (mesma origem).
KIRANA_ACCESS_TOKEN=

# Permite exibir a interface dentro de iframe de outra origem.
# Só use em prévias/sandbox. Mantenha "false" para uso normal.
KIRANA_ALLOW_EMBED=false

# --- Limites de uso --------------------------------------------------------
KIRANA_RATE_LIMIT_MAX=20
KIRANA_RATE_LIMIT_WINDOW_MS=60000
KIRANA_MAX_BODY_BYTES=32768

# --- Tempos limite e orçamentos -------------------------------------------
KIRANA_FIRST_TOKEN_TIMEOUT_MS=20000
KIRANA_REQUEST_TIMEOUT_MS=120000
KIRANA_MAX_TOOL_ROUNDS=4
KIRANA_HISTORY_LIMIT=24
KIRANA_TOOL_RESULT_MAX_CHARS=4000

# --- Compatibilidade de payload com o Gateway v0.2.0 -----------------------
# O gateway v0.2.0 só aceita campos "ChatGPT-plan-compatible" e responde
# HTTP 400 unsupported_parameter para os demais (caso real: temperature).
# Por isso a Kirana NÃO envia esses campos. Ligue apenas se o seu gateway
# passar a aceitá-los — se o gateway recusar, a Kirana remove o campo e
# repete a requisição automaticamente, uma única vez.
KIRANA_SEND_TEMPERATURE=false
KIRANA_SEND_MAX_TOKENS=false
KIRANA_SEND_TOOL_CHOICE=false

# --- Geração (usadas só se o campo correspondente acima estiver habilitado) --
KIRANA_TEMPERATURE=0.6
KIRANA_MAX_TOKENS=0

# --- Voz (Marco 3) ---------------------------------------------------------
# edge    = Microsoft Edge TTS (Thalita Neural PT-BR) via worker Python
# disabled = desliga a voz (a interface continua funcionando por texto)
KIRANA_TTS_PROVIDER=edge
# Comando do Python que o servidor deve executar. No Windows normalmente "py"
# (o worker roda com "py -3"); no Linux/macOS, "python3".
KIRANA_EDGE_TTS_PYTHON=
# Observação: require edge-tts==7.3.1 instalado (pip install edge-tts==7.3.1).
# O áudio vem de um serviço EXTERNO da Microsoft, não oficial para uso em
# produção: a voz não é offline e pode falhar sem aviso. Ver docs/VOZ.md.

# --- Dados locais (sessões, memória, interesses) ---------------------------
KIRANA_DATA_DIR=./data

# --- Observabilidade -------------------------------------------------------
KIRANA_LOG_LEVEL=info
