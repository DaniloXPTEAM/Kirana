# ===========================================================================
# Kirana — configuração de PRODUÇÃO (copie para deploy/.env.production)
#
#   cp deploy/.env.production.example deploy/.env.production
#
# Este arquivo NUNCA vai para o GitHub. O .gitignore cobre `.env.*`, mas
# confira antes de qualquer commit (`git status --short` não deve listá-lo).
# ===========================================================================

# --- Gateway (ver docs/INTEGRACAO-GATEWAY-REAL.md) -------------------------
# Caminho A: o Gateway está no PC do dono, atrás de túnel privado.
# Se os dois estiverem no MESMO host, use http://gateway.local:1455 (ver compose).
KIRANA_GATEWAY_URL=https://gateway-privado.exemplo.interno
# Mesma string de GATEWAY_API_KEY do .env do Gateway. Fica só no servidor.
KIRANA_GATEWAY_API_KEY=

# --- Modelos ---------------------------------------------------------------
# Precisam existir em GET /v1/models da conta (o preflight confere).
KIRANA_PRIMARY_MODEL=gpt-6-luna
KIRANA_FALLBACK_MODEL=gpt-6.1-sol
KIRANA_ALLOW_FALLBACK=true
KIRANA_MODEL_PROBE=true

# --- Servidor --------------------------------------------------------------
KIRANA_HOST=0.0.0.0
KIRANA_PORT=3000
# Liga as travas de produção (sem KIRANA_ACCESS_TOKEN o servidor NÃO sobe).
KIRANA_ENV=production
# Obrigatório atrás do Caddy: sem isto todos os visitantes compartilham o IP do
# proxy e o limite por IP vira um limite global.
KIRANA_TRUST_PROXY=true
# OBRIGATÓRIO em produção: sem isso a API aceita qualquer origem com acesso de rede.
KIRANA_ACCESS_TOKEN=
KIRANA_ALLOW_EMBED=false
KIRANA_SITE_URL=https://opportunity.ia.br
# Origens que podem chamar a Kirana (CORS) e embutir a interface (iframe).
KIRANA_ALLOWED_ORIGINS=https://opportunity.ia.br,https://www.opportunity.ia.br
KIRANA_EMBED_ORIGINS=https://opportunity.ia.br,https://www.opportunity.ia.br

# --- Limites ---------------------------------------------------------------
KIRANA_RATE_LIMIT_MAX=20
KIRANA_RATE_LIMIT_WINDOW_MS=60000
# Balde do transporte do agente (/api/copilot, /api/agui). 0 = desligado.
# Em produção use um valor finito: cada requisição consome plano do Gateway.
KIRANA_AGENT_RATE_MAX=60
KIRANA_MAX_BODY_BYTES=32768

# --- Tempos ----------------------------------------------------------------
KIRANA_FIRST_TOKEN_TIMEOUT_MS=20000
KIRANA_REQUEST_TIMEOUT_MS=120000
KIRANA_MAX_TOOL_ROUNDS=4
KIRANA_HISTORY_LIMIT=24

# --- Compatibilidade de payload (manter false com o Gateway ChatGPT) -------
KIRANA_SEND_TEMPERATURE=false
KIRANA_SEND_MAX_TOKENS=false
KIRANA_SEND_TOOL_CHOICE=false

# --- Dados -----------------------------------------------------------------
KIRANA_DATA_DIR=/data

# --- Voz -------------------------------------------------------------------
# O navegador do visitante fala; o áudio vem do serviço da Microsoft (edge-tts),
# que não é oficial para produção. Deixe `disabled` até decidir o provedor.
KIRANA_TTS_PROVIDER=disabled

# --- Observabilidade -------------------------------------------------------
KIRANA_LOG_LEVEL=info
