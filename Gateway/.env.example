# Copy to .env. This is the gateway-client key, NOT a ChatGPT credential. Do not commit/share .env.
GATEWAY_API_KEY=generate-with-npm-run-keygen
# Private personal runtime only; the app rejects non-loopback bind addresses.
HOST=127.0.0.1
PORT=1455
APP_NAME=Kirana Personal Gateway
APP_ID=kirana-personal-gateway

# Temporary file store. Default: 10 MiB/file, 50 MiB total, 50 files, 1 hour TTL.
# Raise FILE_MAX_BYTES only if needed for local video clips; maximum 250 MiB.
FILE_MAX_BYTES=10485760
FILE_MAX_TOTAL_BYTES=52428800
FILE_MAX_COUNT=50
FILE_TTL_SECONDS=3600

# Optional local speech/video tools: configure paths only after installing/evaluating licenses.
# Windows examples use forward slashes or quoted paths in your .env editor.
# FFMPEG_PATH=C:/Tools/ffmpeg/bin/ffmpeg.exe
# WHISPER_CPP_PATH=C:/Tools/whisper.cpp/whisper-cli.exe
# WHISPER_MODEL_PATH=C:/Models/ggml-base.bin
# WHISPER_TIMEOUT_MS=600000
# PIPER_PATH=C:/Tools/piper/piper.exe
# PIPER_MODEL_PATH=C:/Models/pt_BR-cadu-medium.onnx
# PIPER_VOICE_ID=pt_BR-cadu-medium
# PIPER_TIMEOUT_MS=180000
# VIDEO_ANALYSIS_MAX_SECONDS=180

# Optional ComfyUI local API workflows. Workflows must be API-format JSON and include
# explicit prompt/image/duration bindings as documented in docs/media-api.md.
# Only a loopback HTTP URL is accepted; never expose ComfyUI or this gateway publicly.
# COMFYUI_BASE_URL=http://127.0.0.1:8188
# COMFYUI_IMAGE_GENERATE_WORKFLOW=C:/Kirana/workflows/image-generate.json
# COMFYUI_IMAGE_EDIT_WORKFLOW=C:/Kirana/workflows/image-edit.json
# COMFYUI_VIDEO_GENERATE_WORKFLOW=C:/Kirana/workflows/video-generate.json
# COMFYUI_POLL_INTERVAL_MS=1500
# COMFYUI_MAX_JOB_MS=1200000

# Provider preferences are informational only; they do NOT select/enable a provider.
# The v0.4.0 implemented adapters are SIWC Responses, ComfyUI-local, Whisper.cpp, Piper and FFmpeg.
# KIRANA_IMAGE_ANALYSIS_PROVIDER=
# KIRANA_IMAGE_GENERATION_PROVIDER=
# KIRANA_IMAGE_EDIT_PROVIDER=
# KIRANA_VIDEO_ANALYSIS_PROVIDER=
# KIRANA_VIDEO_GENERATION_PROVIDER=
# KIRANA_SPEECH_TO_TEXT_PROVIDER=
# KIRANA_TEXT_TO_SPEECH_PROVIDER=

# --- Motor de modelos (v0.4.1) --------------------------------------------
# DESLIGADO por padrão: sem estas linhas o gateway executa exatamente o modelo
# pedido, como no v0.4.0. Ligue apenas depois de saber o slug real (GET /v1/models).
# KIRANA_ROUTING=on
# KIRANA_PRIMARY_MODEL=
# KIRANA_FALLBACK_MODEL=
# plan-only (padrão) bloqueia modelo de custo pago com HTTP 402. allow-paid é
# decisão consciente de quem paga a conta; não é padrão.
# KIRANA_COST_POLICY=plan-only
# KIRANA_ENGINE_TIMEOUT_MS=180000
# KIRANA_ENGINE_ATTEMPTS=1
# KIRANA_BREAKER_FAILURES=3
# KIRANA_BREAKER_RESET_MS=30000
# KIRANA_MODEL_CATALOG=config/models.json
# Candidato por capacidade (cap=modelo,cap2=modelo2). Só é usado se a
# capacidade estiver "tested" no catálogo; declarar aqui não autoriza nada.
# KIRANA_SPECIALIZED=
