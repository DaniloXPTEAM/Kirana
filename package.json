{
  "name": "kirana-agent",
  "version": "0.5.3",
  "private": true,
  "description": "Kirana — agente conversacional da Opportunity AI (Fase 2, execução local, com voz)",
  "type": "module",
  "engines": {
    "node": ">=20.6.0"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "mock": "node scripts/mock-gateway.js",
    "doctor": "node scripts/doctor.mjs",
    "audit": "node scripts/audit-contract.mjs",
    "bench": "node scripts/benchmark.mjs",
    "test": "node scripts/run-tests.mjs",
    "test:legacy": "node --test test/*.test.js",
    "voice:bench": "node scripts/voice-bench.mjs",
    "build:widget:v2": "node scripts/build-widget.mjs --v2",
    "site:sync": "node scripts/site-sync.mjs",
    "preflight": "node scripts/preflight-gateway.mjs",
    "homologar": "node scripts/homologar-conversa.mjs",
    "test:routes": "node --test test/copilot-routes.test.js"
  },
  "keywords": [
    "kirana",
    "opportunity-ai",
    "agente",
    "chatgpt-gateway"
  ],
  "license": "UNLICENSED",
  "dependencies": {
    "@ag-ui/client": "1.0.3",
    "@ag-ui/core": "1.0.3",
    "@copilotkit/react-core": "1.79.1",
    "@copilotkit/react-ui": "1.79.1",
    "@copilotkit/runtime": "1.79.1",
    "@langchain/core": "1.3.0",
    "@langchain/langgraph": "1.5.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "playwright": "1.64.1"
  }
}
