# ---------------------------------------------------------------------------
# TamaAgent — exemplo de configuração. Copie para ".env" ou rode CONFIGURAR-TAMAAGENT.cmd.
# NUNCA versione o arquivo .env (ele está no .gitignore) e NUNCA cole a chave em
# conversa, e-mail ou pasta compartilhada.
# Nomes: TAMAAGENT_* e KIRANA_* são equivalentes (KIRANA_* vem do projeto original).
# ---------------------------------------------------------------------------

# --- Provedor de modelo: OmniRoute (formato OpenAI). O Gateway antigo NÃO é usado ---
# Endereço do OmniRoute no PC (com ou sem /v1 no final).
TAMAAGENT_GATEWAY_URL=http://127.0.0.1:20128
# Chave criada no painel do OmniRoute. Fica APENAS no backend do TamaAgent.
TAMAAGENT_GATEWAY_API_KEY=

# --- Modelo ----------------------------------------------------------------
# Nome de um modelo ou "combo" que exista no seu OmniRoute (veja GET /v1/models).
# Se este nome não existir no catálogo, o TamaAgent escolhe um do catálogo real.
TAMAAGENT_PRIMARY_MODEL=
TAMAAGENT_FALLBACK_MODEL=
TAMAAGENT_ALLOW_FALLBACK=true
# Confere em GET /v1/models se o modelo existe antes de usar.
TAMAAGENT_MODEL_PROBE=true

# --- Servidor local ----------------------------------------------------------
TAMAAGENT_HOST=127.0.0.1
TAMAAGENT_PORT=3000
TAMAAGENT_ENV=development

# --- Ponte para o celular (app Tama IA) -------------------------------------
# on = o celular fala com /api/gateway/*; exige token de 32+ caracteres.
# O CONFIGURAR-TAMAAGENT.cmd gera o token sozinho.
TAMAAGENT_BRIDGE=on
TAMAAGENT_BRIDGE_TOKEN=
# Teste por cabo USB (adb reverse) ou rede local, sem Tailscale: deixe off.
# Com Tailscale Serve (HTTPS): coloque on nos dois.
TAMAAGENT_BRIDGE_REQUIRE_HTTPS=off
TAMAAGENT_BRIDGE_TRUST_PROXY=off
